{
  "name": "@lucagiftzek/piece-job-opportunities-api",
  "version": "0.1.0",
  "description": "Activepieces piece for Job Opportunities API (JOA): employer-direct job postings with closures tracked.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "keywords": [
    "activepieces",
    "piece",
    "jobs",
    "job postings",
    "Job Opportunities API",
    "JOA"
  ],
  "homepage": "https://jobopportunitiesapi.org",
  "author": "Loukas Tzekos <support@jobopportunitiesapi.org>",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.lib.json && node scripts/prepare-dist.mjs",
    "test": "npm run build && node --test test/unit.test.mjs",
    "test:live": "npm run build && node --test test/live.test.mjs",
    "pack": "npm run build && npm pack ./dist"
  },
  "dependencies": {
    "@activepieces/pieces-common": "0.12.5",
    "@activepieces/pieces-framework": "0.32.0",
    "tslib": "2.6.2",
    "@activepieces/shared": "0.95.1"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "@types/node": "^22.0.0",
    "nock": "^14.0.17"
  },
  "private": true
}
